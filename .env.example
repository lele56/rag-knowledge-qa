# ============================================================
# 知识库问答助手 - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实凭证
# cp .env.example .env
# ============================================================

# ---------- Qdrant Cloud ----------
# 注册地址: https://cloud.qdrant.io
QDRANT_URL="https://xxxxx.us-west-1-0.aws.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# ---------- Neo4j（本地 Docker，512MB 堆内存）----------
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE=neo4j

# ---------- LLM API (OpenAI 兼容协议) ----------
# 支持: OpenAI / DeepSeek / 通义千问 / 任意 OpenAI-compatible API
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ---------- 本地模型路径 ----------
# 嵌入模型（用于向量化文档和查询）
EMBEDDING_MODEL_PATH=./models/bge-small-zh
# 或使用 BGE-M3（多语言，效果更好但更慢）:
# EMBEDDING_MODEL_PATH=BAAI/bge-m3

# 重排序模型（CrossEncoder，提升检索精度，可选）
# base 版本推荐用于小规模知识库（内存 ~1.1GB）
# v2-m3 版本效果更好但内存占用大（~2.5GB）
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# ---------- 检索策略 ----------
# simple     : 纯向量检索（最快）
# multi_query: LLM 生成多个查询变体（更全）
# hyde       : 生成假设性文档再检索（更准）
RETRIEVAL_STRATEGY=simple
RETRIEVAL_K=5

# ---------- 记忆系统 ----------
MEMORY_WINDOW_SIZE=10

# ---------- 文档切分 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=recursive

# ---------- 缓存 ----------
CACHE_ENABLED=true
CACHE_BACKEND=memory          # memory | redis
CACHE_TTL_SECONDS=3600        # 缓存有效期（秒）
CACHE_MAX_SIZE=1000           # 最大缓存条目（仅 memory 模式有效）

# ---------- Redis（可选，仅 CACHE_BACKEND=redis 或开启限流时需要）----------
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
# RATE_LIMIT_MAX_PER_MINUTE=10
# SESSION_TTL_MINUTES=30

# ---------- Hugging Face ----------
# 国内用户建议启用镜像，避免下载模型失败
HF_ENDPOINT=https://hf-mirror.com
# 避免下载模型时的限流警告，在 https://huggingface.co/settings/tokens 创建
HF_TOKEN=hf_your_token_here

# ---------- 运行时 ----------
USE_CUDA=true                # 是否使用 GPU 加速
DEBUG=false                  # 调试模式（输出更多日志）
SERVER_HOST=0.0.0.0
SERVER_PORT=7860